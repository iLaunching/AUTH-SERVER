# Auth API Environment Variables Template
# Copy this to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Google OAuth Configuration
GOOGLE_CLIENT_SECRET=your-client-secret-from-google-console

# Facebook OAuth Configuration
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# Microsoft OAuth Configuration
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Email Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# OAuth Redirect URIs
# Development
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/auth/facebook/callback
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
FRONTEND_URL=http://localhost:5173

# Production (uncomment and use in production)
# GOOGLE_REDIRECT_URI=https://your-api-domain.com/api/v1/auth/google/callback
# FACEBOOK_REDIRECT_URI=https://your-api-domain.com/api/v1/auth/facebook/callback
# MICROSOFT_REDIRECT_URI=https://your-api-domain.com/api/v1/auth/microsoft/callback
# FRONTEND_URL=https://yourdomain.com

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development  # or 'production'

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Phone verification (Vonage) — optional
# VERIFICATION_ENABLED=false
# VONAGE_APPLICATION_ID=
# Either paste PEM into env, or point at a file (no paste needed):
# VONAGE_PRIVATE_KEY_FILE=/run/secrets/vonage_private.pem
# VONAGE_PRIVATE_KEY=
